{
  "name": "@tempel/commitlint",
  "version": "1.1.0",
  "type": "module",
  "main": "index.cjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "package.json"
  ],
  "scripts": {
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest"
  },
  "author": "Dragos Cirjan <dragos.cirjan@gmail.com>",
  "license": "MIT",
  "description": "Commitlint configuration for Tempel",
  "dependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2"
  },
  "devDependencies": {
    "@tempel/vitest": "workspace:*",
    "vitest": "^5.0.0"
  }
}
